#: includes/class-subscriber-manager-lite-wctlgm-bot-interaction-handler.php:89
msgid ""
"Welcome! Please use the /activate <code> command to start the activation "
"process for your subscription."
msgstr ""
"¡Bienvenido! Utilice el comando /activate <code> para iniciar el proceso de "
"activación de su suscripción."

#. translators: %s is the site name
#: includes/class-subscriber-manager-lite-wctlgm-bot-interaction-handler.php:97
msgid ""
"Welcome! This bot is used to help verify your Telegram User ID and link it "
"to your subscription with %s."
msgstr ""
"¡Bienvenido! Este bot se utiliza para verificar tu ID de usuario de Telegram "
"y vincularlo a tu suscripción con %s."

#: includes/class-subscriber-manager-lite-wctlgm-bot-interaction-handler.php:100
msgid ""
"Please use the /activate <code> command to start the activation process for "
"your subscription."
msgstr ""
"Utilice el comando /activate <code> para iniciar el proceso de activación de "
"su suscripción."

#: includes/class-subscriber-manager-lite-wctlgm-bot-interaction-handler.php:101
msgid "For example, /activate Aq371Do4, and hit enter."
msgstr "Por ejemplo, /activate Aq371Do4 y presiona Enter."

#: includes/class-subscriber-manager-lite-wctlgm-bot-interaction-handler.php:108
msgid ""
"Please include your activation code. Try the /help command for more "
"information."
msgstr ""
"Incluya su código de activación. Pruebe el comando /help para obtener más "
"información."

